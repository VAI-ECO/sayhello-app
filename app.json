{
  "expo": {
    "name": "Say Hello",
    "slug": "sayhello-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "sayhello",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sayhello.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Say Hello uses your location to show nearby Hello Hangouts and place pins when you meet someone.",
        "NSBluetoothAlwaysUsageDescription": "Say Hello uses Bluetooth to help you meet people nearby."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-location",
      "expo-notifications"
    ]
  }
}

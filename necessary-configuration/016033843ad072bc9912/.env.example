# Say Hello App Environment Configuration

# API Base URL
#
# iOS Simulator: use localhost
# Android Emulator: use 10.0.2.2 (special Android localhost alias)
# Physical Device: use your machine's LAN IP (find with `ipconfig getifaddr en0` on Mac)
#
# Examples:
#   API_URL=http://localhost:3000
#   API_URL=http://10.0.2.2:3000
#   API_URL=http://192.168.1.100:3000
#
# Default: http://localhost:3000
API_URL=http://localhost:3000

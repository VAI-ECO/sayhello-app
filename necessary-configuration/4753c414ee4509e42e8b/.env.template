# Say Hello app - environment variable NAMES ONLY (read by app.config.js via resolveApiUrl). No secrets live in the app.
APP_ENV=     # production requires an https API_URL that is not localhost / a private address
API_URL=     # API origin, e.g. a LAN address for a physical device in development
EXPO_PUBLIC_API_URL= # fallback for API_URL when API_URL is unset
EAS_BUILD_PROFILE=   # set by EAS; 'production' applies the same https-only release check as APP_ENV=production
UNIVERSAL_LINK_DOMAIN=   # optional bare hostname; unset = no Android App Link is declared (sayhello:// only). Domain is an owner decision (W8-7)
UNIVERSAL_LINK_SCOPE=    # optional; 'all' claims the whole host, otherwise only the path prefixes the app resolves
ANDROID_PACKAGE=         # optional; read by scripts/universal-links.cjs
ANDROID_SHA256_CERT_FINGERPRINTS= # only for scripts/generate-assetlinks.cjs, which refuses to run without it

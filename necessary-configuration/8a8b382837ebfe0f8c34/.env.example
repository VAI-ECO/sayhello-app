# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:5020/
EXPO_PUBLIC_SOCKET_URL=http://localhost:5020/

# Google Maps API Key
EXPO_PUBLIC_GOOGLE_API_KEY=your_google_api_key_here

# Stripe Public Key (use test key for development)
EXPO_PUBLIC_STRIPE_PUBLIC_KEY=your_stripe_public_key_here

# Production values (replace with your actual endpoints):
# EXPO_PUBLIC_API_URL=https://api.sayhello.world/
# EXPO_PUBLIC_SOCKET_URL=https://api.sayhello.world/
# EXPO_PUBLIC_GOOGLE_API_KEY=AIzaSy...
# EXPO_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_...
